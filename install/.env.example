# ------------------------------------------------------------------
#  Configuración de despliegue de MediaMTX Recording Manager
#  Copia este archivo como ".env" en esta misma carpeta y ajusta los
#  valores a tu propio servidor antes de desplegar.
# ------------------------------------------------------------------

# URL de la API de MediaMTX. Sustituye "mediamtx-mediamtx-1" por el
# nombre real de tu contenedor MediaMTX (compruébalo con: docker ps).
MEDIAMTX_API=http://mediamtx-mediamtx-1:9997

# Red de Docker externa en la que vive tu contenedor de MediaMTX.
# Averíguala con:
#   docker inspect <tu-contenedor-mediamtx> \
#     --format '{{range $net,$conf := .NetworkSettings.Networks}}{{$net}}{{end}}'
MEDIAMTX_NETWORK=mediamtx_default

# Volumen externo donde MediaMTX guarda las grabaciones.
# Averígualo con: docker inspect <tu-contenedor-mediamtx> --format '{{range .Mounts}}{{.Name}}{{"\n"}}{{end}}'
MEDIAMTX_DATA_VOLUME=mediamtx_data

# Puerto en el que se expondrá el panel web en tu servidor.
MANAGER_PORT=8080

# Credenciales iniciales de acceso al panel (usuario: admin / admin). Solo
# se usan la primera vez que arranca; después puedes cambiarlas desde el
# propio panel (⚙ Configuración) sin volver a tocar este archivo.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
