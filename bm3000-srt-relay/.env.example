# URL de origen del BM3000. Confirmado via /get_output en el propio
# equipo (192.168.1.93): RTSP ya esta activo en el path "/0".
BM3000_SOURCE_URL=rtsp://192.168.1.93/0

# Si la fuente es RTSP, fuerza TCP para evitar perdida de paquetes en UDP:
#   BM3000_EXTRA_INPUT_FLAGS=-rtsp_transport tcp
# Si la fuente es RTMP, deja esto vacio:
BM3000_EXTRA_INPUT_FLAGS=-rtsp_transport tcp

# Host de MediaMTX. Si este contenedor comparte la red docker
# "mediamtx_default" con el contenedor real de MediaMTX, usa su
# nombre de contenedor (normalmente "mediamtx"). Si no, usa la IP
# del servidor.
MEDIAMTX_HOST=192.168.1.147

# Puerto SRT de MediaMTX. Por defecto en mediamtx.yml es 8890
# (clave "srtAddress: :8890") -- confirma el valor real en tu servidor.
SRT_PORT=8890

# Nombre del path/stream en MediaMTX. Con streamid=publish:<nombre>,
# el stream quedara disponible como srt://.../<nombre> para leerlo,
# y tambien vía rtsp://.../<nombre>, hls, etc. si MediaMTX lo expone.
STREAM_NAME=bm3000
